        <mxCell id="c250" parent="1" vertex="1" value="ホーム幅：中央 8.600m／中央方端 7.396m／猿沼方端 7.396m。ホーム縁は線路中心から横方向1.7m。" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Hiragino Sans;fontSize=17;fontColor=#203247;">
          <mxGeometry as="geometry" x="55" y="850" width="1600" height="35" />
        </mxCell>
        <mxCell id="c251" parent="1" vertex="1" value="急緩間の同一sでの横間隔は4m。駅Edge境界でもCubicの位置・傾きを維持。勾配・回路境界・接続関係は変更しない。" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Hiragino Sans;fontSize=16;fontColor=#203247;">
          <mxGeometry as="geometry" x="55" y="895" width="1600" height="35" />
        </mxCell>
