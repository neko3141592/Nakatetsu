        <mxCell id="c242" parent="1" vertex="1" value="上り急行線" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Hiragino Sans;fontSize=16;fontColor=#203247;">
