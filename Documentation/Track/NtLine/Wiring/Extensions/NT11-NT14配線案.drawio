        </mxCell>
        <mxCell id="note-1" parent="1" vertex="1" value="下4T → 中田21イT。上りは中田22イT → 上4T。15,460mの渡り線21・22より20m手前で区切る。" style="text;fillColor=none;strokeColor=none;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Hiragino Sans;fontSize=23;fontColor=#1F1F1F;spacing=4;">
