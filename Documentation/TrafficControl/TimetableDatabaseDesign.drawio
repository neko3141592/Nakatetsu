        <mxCell id="db-title" parent="1" vertex="1" value="ダイヤDB構造（GORM / SQLite）" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=24;fontColor=#222222;spacing=0;fontStyle=1;">
          <mxGeometry x="60" y="20" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="db-subtitle" parent="1" vertex="1" value="Server/internal/timetable/models.go と SQLite の物理スキーマに対応" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#222222;spacing=0;">
          <mxGeometry x="60" y="64" width="1200" height="28" as="geometry" />
        </mxCell>
        <mxCell id="ctc-timetable-revision-note" parent="1" vertex="1" value="ID：共通の文字列キー。空白のみのIDはBeforeCreateで拒否。&lt;br&gt;revision ≥ 0、初期値0。自動増分・楽観ロックは未実装。&lt;br&gt;ダイヤ削除：所属リンクだけを削除し、列車・運用は保持。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#222222;spacing=0;">
          <mxGeometry x="60" y="310" width="340" height="95" as="geometry" />
        </mxCell>
        <mxCell id="db-train-links-note" parent="1" vertex="1" value="GORMが自動生成する中間テーブル。&lt;br&gt;ダイヤと列車の多対多。運用未所属の列車も紐づけ可能。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#222222;spacing=0;">
          <mxGeometry x="500" y="280" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="db-train-note" parent="1" vertex="1" value="列番は全体で一意。複数ダイヤで同じ定義を共有。&lt;br&gt;種別・地点・時刻・使用進路を列車に保持する。&lt;br&gt;運用から参照されている列車の削除はRESTRICT。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#222222;spacing=0;">
          <mxGeometry x="940" y="280" width="340" height="95" as="geometry" />
        </mxCell>
        <mxCell id="db-operation-links-note" parent="1" vertex="1" value="GORMが自動生成する中間テーブル。&lt;br&gt;ダイヤと運用の多対多。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#222222;spacing=0;">
          <mxGeometry x="60" y="560" width="340" height="75" as="geometry" />
        </mxCell>
        <mxCell id="ctc-operations-note" parent="1" vertex="1" value="運用番号は全体で一意。複数ダイヤで共有する。&lt;br&gt;運用削除：ダイヤとの関連と運用内の列車順序だけを削除。&lt;br&gt;列車・地点・使用進路の定義は保持する。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#222222;spacing=0;">
          <mxGeometry x="500" y="530" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="db-operation-trains-note" parent="1" vertex="1" value="PK (operation_number, train_number)&lt;br&gt;UQ (operation_number, sequence_index)&lt;br&gt;sequence_index ≥ 0。運用内の列車順序を保持。&lt;br&gt;列車を運用へ追加しても、ダイヤへの所属は別に設定。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#222222;spacing=0;">
          <mxGeometry x="940" y="590" width="340" height="115" as="geometry" />
        </mxCell>
        <mxCell id="ctc-complete-note-24" parent="1" vertex="1" value="UQ (train_number, sequence_index)&lt;br&gt;sequence_index ≥ 0。地点IDは自動採番。&lt;br&gt;handling = pass / stop / unspecified（初期値）&lt;br&gt;時刻：運行日0時からの非負秒数。NULL可、24時以降も可。&lt;br&gt;到着・出発とも指定した場合は arrival ≤ departure。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#222222;spacing=0;">
          <mxGeometry x="1380" y="730" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ctc-complete-note-25" parent="1" vertex="1" value="PK (timetable_point_id, sequence_index)&lt;br&gt;FK (control_station_id, route_id) → routes の複合PK&lt;br&gt;sequence_index ≥ 0。当地点から次地点までの使用進路順。&lt;br&gt;終端地点は使用進路0件。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#222222;spacing=0;">
          <mxGeometry x="1820" y="630" width="340" height="105" as="geometry" />
        </mxCell>
        <mxCell id="ctc-station-times-note-25" parent="1" vertex="1" value="PK (train_type_id, from_station_id, to_station_id)&lt;br&gt;running_seconds &gt; 0。逆方向は別レコード。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#222222;spacing=0;">
          <mxGeometry x="60" y="940" width="350" height="55" as="geometry" />
        </mxCell>
        <mxCell id="db-train-types-note" parent="1" vertex="1" value="列車種別マスター。&lt;br&gt;種別削除で標準運転時分も削除。&lt;br&gt;列車から参照されている種別は削除不可。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#222222;spacing=0;">
          <mxGeometry x="500" y="890" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="db-circuits-note" parent="1" vertex="1" value="設備IDの参照カタログ。&lt;br&gt;表示名・連動条件は設備定義側に保持する。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#222222;spacing=0;">
          <mxGeometry x="940" y="860" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="db-stations-note" parent="1" vertex="1" value="駅マスター。地点のstation_idはNULL可。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#222222;spacing=0;">
          <mxGeometry x="60" y="1110" width="350" height="45" as="geometry" />
        </mxCell>
        <mxCell id="ctc-minimal-masters-note-17" parent="1" vertex="1" value="PK (control_station_id, route_id)&lt;br&gt;設備IDの参照カタログ。&lt;br&gt;control_station_idからstationsへのFKはない。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#222222;spacing=0;">
          <mxGeometry x="1820" y="890" width="340" height="95" as="geometry" />
        </mxCell>
        <mxCell id="db-legend" parent="1" vertex="1" value="PK：主キー（複数のPK欄は複合キー）　FK：外部キー　UQ：一意制約&lt;br&gt;NULL表記のある列のみNULL可。FKの更新時動作はすべてCASCADE。&lt;br&gt;線のC：ON DELETE CASCADE　R：ON DELETE RESTRICT。子側は0～複数件。&lt;br&gt;親側の○は関連省略可を示す（地点のstation_id）。" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#222222;spacing=0;">
          <mxGeometry x="500" y="1010" width="760" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
