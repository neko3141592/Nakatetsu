        <mxCell id="IntegratePatterns" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;IntegratePatterns&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;終端側から速度を逆積分。&lt;br&gt;ORPは終端の指定距離内だけ積分。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="IntegratePatterns" owner="TrainAtcPatternLogic">
          <mxGeometry x="80" y="1500" width="500" height="140" as="geometry" />
