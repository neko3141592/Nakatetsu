        <mxCell id="UpdateAtcOutput" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;UpdateAtcOutput&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;ATC全体状態 → ブレーキ → パターン表示の順にOutputを更新。&lt;br&gt;入力不正・パターン使用不可の場合も実行する。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="UpdateAtcOutput" owner="TrainAtcOutputLogic">
