        <mxCell id="edge-3" parent="1" source="TryAdvancePosition" target="TryResolveNextAtcEdge" value="Edge境界" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontSize=13;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
