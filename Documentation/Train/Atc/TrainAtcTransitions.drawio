<mxfile host="Electron" pages="8" version="31.7.0">
  <diagram name="TrainAtcLogic.cs" id="atc-TrainAtcLogic">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="920" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" value="TrainAtcLogic.cs" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;fontSize=24;strokeColor=none;fillColor=none;">
          <mxGeometry x="80" y="30" width="1500" height="36" as="geometry" />
        </mxCell>
        <mxCell id="caption" parent="1" value="全体の呼び出し順。各工程の詳細は対応するLogicページを参照。" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;fontSize=15;strokeColor=none;fillColor=none;">
          <mxGeometry x="80" y="76" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Calculate" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;Calculate&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;工程1の入力スナップショットを受け、工程2〜8を実行。&lt;br&gt;&lt;br&gt;前回のselectedReceiverを保存&lt;br&gt;&lt;a href=&quot;data:page/id,atc-TrainAtcOperationLogic&quot; style=&quot;color:#222222&quot;&gt;2. UpdateOperation：操作・使用受電器・電文を選択&lt;/a&gt;&lt;br&gt;&lt;a href=&quot;data:page/id,atc-TrainAtcPositionLogic&quot; style=&quot;color:#222222&quot;&gt;3. UpdatePosition：基準端を進め、他端を相対再解決&lt;/a&gt;&lt;br&gt;&lt;a href=&quot;data:page/id,atc-TrainAtcOperationLogic&quot; style=&quot;color:#222222&quot;&gt;UpdateCurrentPosition：最新の照査位置・方向を確定&lt;/a&gt;&lt;br&gt;選択結果の変更を判定&lt;br&gt;&lt;a href=&quot;data:page/id,atc-TrainAtcValidationLogic&quot; style=&quot;color:#222222&quot;&gt;4. UpdateValidation：入力・受信・保持を判定&lt;/a&gt;&lt;br&gt;&lt;a href=&quot;data:page/id,atc-TrainAtcProtectionModeLogic&quot; style=&quot;color:#222222&quot;&gt;5. UpdateProtectionMode：防護方式を確定&lt;/a&gt;&lt;br&gt;ValidateProtectionSettings：使用方式の設定確認&lt;br&gt;&lt;a href=&quot;data:page/id,atc-TrainAtcPatternLogic&quot; style=&quot;color:#222222&quot;&gt;6. UpdatePattern：パターンを更新&lt;/a&gt;&lt;br&gt;各工程の結果からATC全体の正常性を決定&lt;br&gt;&lt;a href=&quot;data:page/id,atc-TrainAtcBrakeLogic&quot; style=&quot;color:#222222&quot;&gt;7. UpdateBrakeState：要求・非常保持を更新&lt;/a&gt;&lt;br&gt;&lt;a href=&quot;data:page/id,atc-TrainAtcOutputLogic&quot; style=&quot;color:#222222&quot;&gt;8. UpdateAtcOutput：Outputを生成&lt;/a&gt;&lt;br&gt;&lt;br&gt;前工程が使用不可でも工程7・8を実行。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#dae8fc;" function="Calculate" owner="TrainAtcLogic">
          <mxGeometry x="80" y="140" width="660" height="540" as="geometry" />
        </mxCell>
        <mxCell id="TryInitializePosition" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;TryInitializePosition&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;GraphとEdge辞書を設定し、&lt;br&gt;PositionLogicへ両端の初期位置を渡す。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#dae8fc;" function="TryInitializePosition" owner="TrainAtcLogic">
          <mxGeometry x="900" y="140" width="660" height="140" as="geometry" />
        </mxCell>
        <mxCell id="TryCreateEdgeDictionary" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;TryCreateEdgeDictionary&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Graphと線区最高速度を確認し、&lt;br&gt;Edge IDからEdgeを取得する辞書を作成。&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;呼び出し元: TryInitializePosition&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="TryCreateEdgeDictionary" owner="TrainAtcLogic">
          <mxGeometry x="900" y="360" width="660" height="140" as="geometry" />
        </mxCell>
        <mxCell id="TryCorrectPosition" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;TryCorrectPosition&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;両端の補正位置をPositionLogicへ渡す。&lt;br&gt;両端不明から明示的に復帰させる。&lt;br&gt;片側だけの不明は相対解決でも復帰できる。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#dae8fc;" function="TryCorrectPosition" owner="TrainAtcLogic">
          <mxGeometry x="900" y="620" width="660" height="140" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" parent="1" source="TryInitializePosition" target="TryCreateEdgeDictionary" value="" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontSize=13;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" value="青: Controllerが外部公開するAPIに対応する関数　白: その他のLogic関数" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;fontSize=14;strokeColor=none;fillColor=none;">
          <mxGeometry x="80" y="710" width="660" height="60" as="geometry" />
        </mxCell>
        <mxCell id="flow-note" parent="1" value="各ページの矢印は主な実行順・分岐。共通補助関数は別欄にまとめ、呼び出し元を記載。" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;fontSize=14;strokeColor=none;fillColor=none;">
          <mxGeometry x="80" y="790" width="660" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="TrainAtcPositionLogic.cs" id="atc-TrainAtcPositionLogic">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="3020" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" value="TrainAtcPositionLogic.cs" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;fontSize=24;strokeColor=none;fillColor=none;">
          <mxGeometry x="80" y="30" width="1800" height="36" as="geometry" />
        </mxCell>
        <mxCell id="caption" parent="1" value="工程3。既知の使用側を優先して基準を進め、他端を相対再解決。片側不明は毎tick再試行、両側不明は明示補正で復帰。" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;fontSize=15;strokeColor=none;fillColor=none;">
          <mxGeometry x="80" y="76" width="1800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="UpdatePosition" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;UpdatePosition&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;初期化・共通入力を確認 → 既知の基準端を選択。&lt;br&gt;基準端を更新後、他端を相対解決する。&lt;br&gt;各端の既知フラグはPositionStateだけが更新。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="UpdatePosition" owner="TrainAtcPositionLogic">
          <mxGeometry x="80" y="140" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="TryGetMovementDistance" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;TryGetMovementDistance&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;測定速度 × 経過時間で符号付き距離を計算。&lt;br&gt;dt不正、dt &gt; 0で速度欠損・不正なら失敗。&lt;br&gt;dt = 0なら速度取得によらず移動距離0。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="TryGetMovementDistance" owner="TrainAtcPositionLogic">
          <mxGeometry x="80" y="400" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="SelectReferenceReceiver" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;SelectReferenceReceiver&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;選択端が既知なら優先、未知なら既知の他端。&lt;br&gt;無効時は取得済み運転台側の既知位置を優先。&lt;br&gt;操作不明時は既知の前側、次に後側。&lt;br&gt;両端不明ならNoneを返す。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="SelectReferenceReceiver" owner="TrainAtcPositionLogic">
          <mxGeometry x="80" y="660" width="500" height="180" as="geometry" />
        </mxCell>
        <mxCell id="UpdateReferencePosition" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;UpdateReferencePosition&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;基準端の前回位置をTryAdvancePositionで進め、&lt;br&gt;成功した最新位置を採用する。&lt;br&gt;失敗はUpdatePositionへfalseを返す。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="UpdateReferencePosition" owner="TrainAtcPositionLogic">
          <mxGeometry x="80" y="960" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="UpdateRelativePosition" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;UpdateRelativePosition&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;基準端の最新位置から他端を毎tick再解決。&lt;br&gt;他端の過去位置は速度積算に使わない。&lt;br&gt;成功：新位置を採用し、その端を既知にする。&lt;br&gt;失敗：対象端だけ不明、最後の位置は診断に残す。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="UpdateRelativePosition" owner="TrainAtcPositionLogic">
          <mxGeometry x="80" y="1230" width="500" height="190" as="geometry" />
        </mxCell>
        <mxCell id="ClearPositionKnown" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;ClearPositionKnown&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;未初期化・共通移動入力不正・基準端更新失敗。&lt;br&gt;両端の既知フラグをfalseにし、最後の位置は残す。&lt;br&gt;古い他端をそのtickの最新位置として使用しない。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="ClearPositionKnown" owner="TrainAtcPositionLogic">
          <mxGeometry x="700" y="140" width="500" height="180" as="geometry" />
        </mxCell>
        <mxCell id="both-unknown" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;両端不明&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;既知の基準がないため自動更新できない。&lt;br&gt;CorrectPositionの明示補正で両端既知へ戻る。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;">
          <mxGeometry x="700" y="430" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="partial-known" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;片側だけ不明&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;既知の基準が残る間、相対再解決を毎tick継続。&lt;br&gt;今回解決できれば、使用側・非使用側によらず復帰。&lt;br&gt;選択端がまだ不明なら、その側の照査は使用不可。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;">
          <mxGeometry x="700" y="710" width="500" height="180" as="geometry" />
        </mxCell>
        <mxCell id="TryGetRelativeDistance" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;TryGetRelativeDistance&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;hasCarMasses、両端距離の有限・非負、rear ≥ frontを確認。&lt;br&gt;基準端距離 − 他端距離で固定前方向の変位を求める。&lt;br&gt;間隔0も許可。失敗は他端だけ不明にする。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="TryGetRelativeDistance" owner="TrainAtcPositionLogic">
          <mxGeometry x="700" y="1230" width="500" height="190" as="geometry" />
        </mxCell>
        <mxCell id="InitializePosition" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;InitializePosition&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;有効な両端の初期位置と向きをコピー。&lt;br&gt;初期化は一度だけ。両端の既知フラグをtrue。&lt;br&gt;呼び出し元：TrainAtcLogic.TryInitializePosition&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="InitializePosition" owner="TrainAtcPositionLogic">
          <mxGeometry x="1320" y="140" width="500" height="180" as="geometry" />
        </mxCell>
        <mxCell id="CorrectPosition" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;CorrectPosition&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;補正する両端位置を確認・コピー。&lt;br&gt;両端の既知フラグをtrueにして明示復帰。&lt;br&gt;呼び出し元：TrainAtcLogic.TryCorrectPosition&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="CorrectPosition" owner="TrainAtcPositionLogic">
          <mxGeometry x="1320" y="430" width="500" height="180" as="geometry" />
        </mxCell>
        <mxCell id="flags" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;位置把握と後工程&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;isFrontPositionKnown / isRearPositionKnownを個別保持。&lt;br&gt;IsPositionKnownは両フラグのANDを返す診断用プロパティ。&lt;br&gt;Operation.UpdateCurrentPositionは選択端だけを要求。&lt;br&gt;非使用側だけの不明は既知の使用側の照査を止めない。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;">
          <mxGeometry x="1320" y="710" width="500" height="200" as="geometry" />
        </mxCell>
        <mxCell id="helpers" parent="1" value="位置・接続解決の共通補助関数" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;fontSize=18;strokeColor=none;fillColor=none;">
          <mxGeometry x="80" y="1510" width="1760" height="40" as="geometry" />
        </mxCell>
        <mxCell id="TryAdvancePosition" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;TryAdvancePosition&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;位置をコピーしてEdge内・複数Edgeの変位を解決。&lt;br&gt;境界を跨いだら編成の向きも更新。&lt;br&gt;呼び出し元：UpdateReferencePosition / UpdateRelativePosition&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="TryAdvancePosition" owner="TrainAtcPositionLogic">
          <mxGeometry x="80" y="1580" width="500" height="170" as="geometry" />
        </mxCell>
        <mxCell id="TryResolveNextAtcEdge" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;TryResolveNextAtcEdge&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;電文内経路 → 隣接回路の選択済み起点 → 保持経路 → Graph。&lt;br&gt;今回一意に特定できる次Edgeだけを採用。&lt;br&gt;呼び出し元：TryAdvancePosition&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="TryResolveNextAtcEdge" owner="TrainAtcPositionLogic">
          <mxGeometry x="700" y="1580" width="500" height="170" as="geometry" />
        </mxCell>
        <mxCell id="RebindSelectedEdge" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;RebindSelectedEdge&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;同一回路の共通物理区間にいる場合だけ、&lt;br&gt;受信した選択Edge上の同じ位置へ対応し直す。&lt;br&gt;分岐後の別枝へは付け替えない。&lt;br&gt;呼び出し元：TryAdvancePosition&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="RebindSelectedEdge" owner="TrainAtcPositionLogic">
          <mxGeometry x="1320" y="1580" width="500" height="180" as="geometry" />
        </mxCell>
        <mxCell id="TryResolveNextOnPath" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;TryResolveNextOnPath&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;現在Edgeの前後から出口Nodeに接続するEdgeを探す。&lt;br&gt;呼び出し元：TryResolveNextAtcEdge / TryResolveNextOnRoute&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="TryResolveNextOnPath" owner="TrainAtcPositionLogic">
          <mxGeometry x="80" y="1860" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="TryResolveSelectedOrigin" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;TryResolveSelectedOrigin&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;受信回路が保持位置より先に隣へ移った場合、&lt;br&gt;退出Nodeに接続する選択済み起点Edgeを使う。&lt;br&gt;呼び出し元：TryResolveNextAtcEdge&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="TryResolveSelectedOrigin" owner="TrainAtcPositionLogic">
          <mxGeometry x="700" y="1860" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="TryResolveNextOnGraph" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;TryResolveNextOnGraph&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Graphの接続先が一つなら採用。&lt;br&gt;複数ならTryResolveNextOnRouteで静的進路を確認。&lt;br&gt;呼び出し元：TryResolveNextAtcEdge&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="TryResolveNextOnGraph" owner="TrainAtcPositionLogic">
          <mxGeometry x="1320" y="1860" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="TryMapPhysicalPosition" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;TryMapPhysicalPosition&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;選択EdgeのphysicalSpans上へ位置・向きを変換。&lt;br&gt;対応が一意で範囲内の場合だけ成功。&lt;br&gt;呼び出し元：RebindSelectedEdge&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="TryMapPhysicalPosition" owner="TrainAtcPositionLogic">
          <mxGeometry x="80" y="2120" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="IsValidSpan" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;IsValidSpan&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;物理区間のIDと距離が正常か確認。&lt;br&gt;呼び出し元：RebindSelectedEdge / TryMapPhysicalPosition&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="IsValidSpan" owner="TrainAtcPositionLogic">
          <mxGeometry x="700" y="2120" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="TryResolveNextOnRoute" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;TryResolveNextOnRoute&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;開通状態によらず、静的進路の行先が一つなら採用。&lt;br&gt;呼び出し元：TryResolveNextOnGraph&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="TryResolveNextOnRoute" owner="TrainAtcPositionLogic">
          <mxGeometry x="1320" y="2120" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="IsValidPosition" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;IsValidPosition&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Edge内位置の正常性を確認。&lt;br&gt;呼び出し元：InitializePosition / CorrectPosition / TryAdvancePosition&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="IsValidPosition" owner="TrainAtcPositionLogic">
          <mxGeometry x="80" y="2390" width="500" height="160" as="geometry" />
