  <diagram name="TrainAtcPatternLogic.cs" id="atc-TrainAtcPatternLogic">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2080" pageHeight="2440" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" value="TrainAtcPatternLogic.cs" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;fontSize=24;strokeColor=none;fillColor=none;">
          <mxGeometry x="80" y="30" width="1920" height="36" as="geometry" />
        </mxCell>
        <mxCell id="caption" parent="1" value="工程6。採用時は新規生成、保持時は現在値のみ更新。途中失敗は一括消去し、旧パターンへ戻さない。" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;fontSize=15;strokeColor=none;fillColor=none;">
          <mxGeometry x="80" y="76" width="1920" height="40" as="geometry" />
        </mxCell>
        <mxCell id="UpdatePattern" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;UpdatePattern&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Adopt: 作業用パターンを生成し、成功後にStateへ採用。&lt;br&gt;Retain: 前回経路から現在値のみ更新。&lt;br&gt;使用不可・方式不明・生成／位置参照失敗: 一括消去。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="UpdatePattern" owner="TrainAtcPatternLogic">
          <mxGeometry x="700" y="140" width="500" height="180" as="geometry" />
        </mxCell>
        <mxCell id="create-section" parent="1" value="新規生成" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;fontSize=18;strokeColor=none;fillColor=none;">
          <mxGeometry x="80" y="340" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="helpers-section" parent="1" value="共通補助関数" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;fontSize=18;strokeColor=none;fillColor=none;">
          <mxGeometry x="1320" y="340" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="PreparePath" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;PreparePath&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;経路の接続・方向・長さと、&lt;br&gt;各Edgeの速度制限・勾配を準備。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="PreparePath" owner="TrainAtcPatternLogic">
          <mxGeometry x="80" y="400" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="InitializePatterns" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;InitializePatterns&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;常用・非常・Restricted時のORPを初期化。&lt;br&gt;サンプル間隔と計算用減速度を設定。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="InitializePatterns" owner="TrainAtcPatternLogic">
          <mxGeometry x="80" y="620" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ApplyPermanentSpeedLimits" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;ApplyPermanentSpeedLimits&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;常設制限を常用と非常へ反映。&lt;br&gt;非常は常設制限＋10km/h。ORPへは反映しない。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="ApplyPermanentSpeedLimits" owner="TrainAtcPatternLogic">
          <mxGeometry x="80" y="840" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ApplyStopTargets" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;ApplyStopTargets&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;防護方式に応じて停止目標と低速制限を設定。&lt;br&gt;通常非常は全方式で終端1サンプル手前から0。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="ApplyStopTargets" owner="TrainAtcPatternLogic">
          <mxGeometry x="80" y="1060" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="CalculateGradientCorrections" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;CalculateGradientCorrections&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;各車の質量・中心位置・受電器位置から、&lt;br&gt;区間ごとの勾配補正を計算。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="CalculateGradientCorrections" owner="TrainAtcPatternLogic">
          <mxGeometry x="80" y="1280" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="IntegratePatterns" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;IntegratePatterns&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;終端側から速度を逆積分。&lt;br&gt;ORPは終端の指定距離内だけ積分。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="IntegratePatterns" owner="TrainAtcPatternLogic">
          <mxGeometry x="80" y="1500" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="UpdatePatternSections-all" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;UpdatePatternSections&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;常用・非常・ORPそれぞれの&lt;br&gt;降下・接近区間と目標速度を更新。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="UpdatePatternSections" owner="TrainAtcPatternLogic">
