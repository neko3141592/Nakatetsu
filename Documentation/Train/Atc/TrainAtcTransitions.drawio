        </mxCell>
        <mxCell id="mode-adopt" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;今回の方式を採用&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;AdoptかつNormal／Restricted／None。&lt;br&gt;方式を保存し、isProtectionModeKnownをtrueにする。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;">
