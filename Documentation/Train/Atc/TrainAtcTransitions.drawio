  <diagram name="TrainAtcLogic.cs" id="atc-TrainAtcLogic">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="880" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" value="TrainAtcLogic.cs" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;fontSize=24;strokeColor=none;fillColor=none;">
          <mxGeometry x="80" y="30" width="1500" height="36" as="geometry" />
        </mxCell>
        <mxCell id="caption" parent="1" value="全体の呼び出し順。各工程の詳細は対応するLogicページを参照。" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;fontSize=15;strokeColor=none;fillColor=none;">
          <mxGeometry x="80" y="76" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="Calculate" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;Calculate&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;入力スナップショットを受け、工程2〜8を実行。&lt;br&gt;&lt;br&gt;&lt;a href=&quot;data:page/id,atc-TrainAtcPositionLogic&quot; style=&quot;color:#222222&quot;&gt;2. 列車位置を更新&lt;/a&gt;&lt;br&gt;&lt;a href=&quot;data:page/id,atc-TrainAtcOperationLogic&quot; style=&quot;color:#222222&quot;&gt;3. 有効状態・使用受電器を決定&lt;/a&gt;&lt;br&gt;&lt;a href=&quot;data:page/id,atc-TrainAtcValidationLogic&quot; style=&quot;color:#222222&quot;&gt;4. 入力・受信状態を判定&lt;/a&gt;&lt;br&gt;&lt;a href=&quot;data:page/id,atc-TrainAtcProtectionModeLogic&quot; style=&quot;color:#222222&quot;&gt;5. 防護方式を確定&lt;/a&gt;&lt;br&gt;&lt;a href=&quot;data:page/id,atc-TrainAtcPatternLogic&quot; style=&quot;color:#222222&quot;&gt;6. 常用・非常・ORPパターンを更新&lt;/a&gt;&lt;br&gt;各工程の結果からATC全体の正常性を決定&lt;br&gt;&lt;a href=&quot;data:page/id,atc-TrainAtcBrakeLogic&quot; style=&quot;color:#222222&quot;&gt;7. ブレーキ状態を更新&lt;/a&gt;&lt;br&gt;&lt;a href=&quot;data:page/id,atc-TrainAtcOutputLogic&quot; style=&quot;color:#222222&quot;&gt;8. Outputを生成&lt;/a&gt;&lt;br&gt;&lt;br&gt;前工程が使用不可でもブレーキ判定・Output生成を実行。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#dae8fc;" function="Calculate" owner="TrainAtcLogic">
          <mxGeometry x="80" y="140" width="660" height="480" as="geometry" />
        </mxCell>
        <mxCell id="TryInitializePosition" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;TryInitializePosition&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;GraphとEdge辞書を設定し、&lt;br&gt;PositionLogicへ両端の初期位置を渡す。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#dae8fc;" function="TryInitializePosition" owner="TrainAtcLogic">
          <mxGeometry x="900" y="140" width="660" height="140" as="geometry" />
        </mxCell>
        <mxCell id="TryCreateEdgeDictionary" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;TryCreateEdgeDictionary&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Graphと線区最高速度を確認し、&lt;br&gt;Edge IDからEdgeを取得する辞書を作成。&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;呼び出し元: TryInitializePosition&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="TryCreateEdgeDictionary" owner="TrainAtcLogic">
          <mxGeometry x="900" y="360" width="660" height="140" as="geometry" />
        </mxCell>
        <mxCell id="TryCorrectPosition" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;TryCorrectPosition&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;PositionLogicへ両端の補正位置を渡す。&lt;br&gt;位置不明からの復帰は明示的に行う。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#dae8fc;" function="TryCorrectPosition" owner="TrainAtcLogic">
          <mxGeometry x="900" y="620" width="660" height="140" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" parent="1" source="TryInitializePosition" target="TryCreateEdgeDictionary" value="" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontSize=13;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" value="青: Controllerが外部公開するAPIに対応する関数　白: その他のLogic関数" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;fontSize=14;strokeColor=none;fillColor=none;">
          <mxGeometry x="80" y="640" width="660" height="60" as="geometry" />
        </mxCell>
        <mxCell id="flow-note" parent="1" value="各ページの矢印は主な実行順・分岐。共通補助関数は別欄にまとめ、呼び出し元を記載。" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;fontSize=14;strokeColor=none;fillColor=none;">
          <mxGeometry x="80" y="720" width="660" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="TrainAtcPositionLogic.cs" id="atc-TrainAtcPositionLogic">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1890" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" value="TrainAtcPositionLogic.cs" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;fontSize=24;strokeColor=none;fillColor=none;">
          <mxGeometry x="80" y="30" width="1800" height="36" as="geometry" />
        </mxCell>
        <mxCell id="caption" parent="1" value="工程2。キー・レバーサに関係なく両端位置を更新。片側失敗時は両端の記録を保持し、位置不明にする。" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;fontSize=15;strokeColor=none;fillColor=none;">
          <mxGeometry x="80" y="76" width="1800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="UpdatePosition" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;UpdatePosition&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;両端の移動をコピー上で計算し、&lt;br&gt;両方成功した場合だけ位置を更新。&lt;br&gt;位置不明から自動で再初期化しない。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="UpdatePosition" owner="TrainAtcPositionLogic">
          <mxGeometry x="80" y="140" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="TryGetMovementDistance" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;TryGetMovementDistance&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;測定速度 × 経過時間で移動距離を計算。&lt;br&gt;正方向は編成の固定前側。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="TryGetMovementDistance" owner="TrainAtcPositionLogic">
          <mxGeometry x="80" y="380" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="TryAdvancePosition" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;TryAdvancePosition&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;各受電器をEdge内・次のEdgeへ移動。&lt;br&gt;境界を越えたら編成の向きも更新。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="TryAdvancePosition" owner="TrainAtcPositionLogic">
          <mxGeometry x="80" y="620" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="TryResolveNextAtcEdge" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;TryResolveNextAtcEdge&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;電文 → 保持経路 → Graphの順で、&lt;br&gt;移動先Edgeを解決する。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="TryResolveNextAtcEdge" owner="TrainAtcPositionLogic">
          <mxGeometry x="80" y="860" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="TryResolveNextOnPath" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;TryResolveNextOnPath&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;現在Edgeの前後にあるEdgeから、&lt;br&gt;出口Nodeに接続する移動先を特定。&lt;br&gt;電文と保持経路を順に参照。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="TryResolveNextOnPath" owner="TrainAtcPositionLogic">
          <mxGeometry x="700" y="860" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="TryResolveNextOnGraph" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;TryResolveNextOnGraph&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Graphの接続先が一つなら採用。&lt;br&gt;複数なら定義済み進路を確認。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="TryResolveNextOnGraph" owner="TrainAtcPositionLogic">
          <mxGeometry x="700" y="1120" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="TryResolveNextOnRoute" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;TryResolveNextOnRoute&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;進路の開通状態によらず、&lt;br&gt;定義済み進路の行き先が一つなら採用。&lt;br&gt;進路ごとにTryResolveNextOnPathを使用。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="TryResolveNextOnRoute" owner="TrainAtcPositionLogic">
          <mxGeometry x="700" y="1360" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="InitializePosition" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;InitializePosition&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;両端の初期位置と編成の向きをコピー。&lt;br&gt;初期化は一度だけ。&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;呼び出し元: TrainAtcLogic.TryInitializePosition&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="InitializePosition" owner="TrainAtcPositionLogic">
          <mxGeometry x="1320" y="140" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="CorrectPosition" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;CorrectPosition&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;両端の補正位置を確認・コピーし、&lt;br&gt;位置不明から明示的に復帰。&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;呼び出し元: TrainAtcLogic.TryCorrectPosition&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="CorrectPosition" owner="TrainAtcPositionLogic">
          <mxGeometry x="1320" y="380" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="helpers" parent="1" value="共通補助関数" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;fontSize=18;strokeColor=none;fillColor=none;">
          <mxGeometry x="80" y="1580" width="1760" height="40" as="geometry" />
        </mxCell>
        <mxCell id="IsValidPosition" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;IsValidPosition&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Edge内の位置が有効か確認。&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;呼び出し元: InitializePosition / CorrectPosition / TryAdvancePosition&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="IsValidPosition" owner="TrainAtcPositionLogic">
          <mxGeometry x="80" y="1640" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="CopyPosition" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;CopyPosition&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Edge ID・距離・編成の向きをコピー。&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;呼び出し元: InitializePosition / CorrectPosition / TryAdvancePosition&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="CopyPosition" owner="TrainAtcPositionLogic">
          <mxGeometry x="700" y="1640" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="TryGetAtcEdge" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;TryGetAtcEdge&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;辞書からEdgeを取得し、長さを確認。&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;呼び出し元: IsValidPosition / TryAdvancePosition / 経路・Graph解決&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="TryGetAtcEdge" owner="TrainAtcPositionLogic">
          <mxGeometry x="1320" y="1640" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" parent="1" source="UpdatePosition" target="TryGetMovementDistance" value="" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontSize=13;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" parent="1" source="TryGetMovementDistance" target="TryAdvancePosition" value="両端を計算" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontSize=13;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
