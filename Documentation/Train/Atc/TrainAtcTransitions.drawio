        <mxCell id="InitializePatterns" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;InitializePatterns&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;常用・非常・Restricted時のORPを初期化。&lt;br&gt;サンプル間隔と計算用減速度を設定。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="InitializePatterns" owner="TrainAtcPatternLogic">
          <mxGeometry x="80" y="620" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ApplyPermanentSpeedLimits" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;ApplyPermanentSpeedLimits&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;常設制限を常用と非常へ反映。&lt;br&gt;非常は常設制限＋10km/h。ORPへは反映しない。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="ApplyPermanentSpeedLimits" owner="TrainAtcPatternLogic">
          <mxGeometry x="80" y="840" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ApplyStopTargets" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;ApplyStopTargets&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;防護方式に応じて停止目標と低速制限を設定。&lt;br&gt;通常非常は全方式で終端1サンプル手前から0。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="ApplyStopTargets" owner="TrainAtcPatternLogic">
          <mxGeometry x="80" y="1060" width="500" height="140" as="geometry" />
