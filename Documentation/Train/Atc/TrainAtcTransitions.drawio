        <mxCell id="UpdatePatternSections-all" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;UpdatePatternSections&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;常用・非常・ORPそれぞれの&lt;br&gt;降下・接近区間と目標速度を更新。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="UpdatePatternSections" owner="TrainAtcPatternLogic">
