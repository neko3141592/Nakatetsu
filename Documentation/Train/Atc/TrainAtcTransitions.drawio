        <mxCell id="CalculateGradientCorrections" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;CalculateGradientCorrections&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;各車の質量・中心位置・受電器位置から、&lt;br&gt;区間ごとの勾配補正を計算。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="CalculateGradientCorrections" owner="TrainAtcPatternLogic">
