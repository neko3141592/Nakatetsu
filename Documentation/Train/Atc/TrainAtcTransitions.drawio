  <diagram name="TrainAtcValidationLogic.cs" id="atc-TrainAtcValidationLogic">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="1720" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" value="TrainAtcValidationLogic.cs" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;fontSize=24;strokeColor=none;fillColor=none;">
          <mxGeometry x="80" y="30" width="1800" height="36" as="geometry" />
        </mxCell>
        <mxCell id="caption" parent="1" value="工程4。入力不正でも電文読取と無信号時間更新を行う。受信回復時は後工程の成功を待たずリセット。" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;fontSize=15;strokeColor=none;fillColor=none;">
          <mxGeometry x="80" y="76" width="1800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="UpdateValidation" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;UpdateValidation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;入力・受信・必要な方式別設定を確認し、&lt;br&gt;採用・保持・使用不可を決定。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="UpdateValidation" owner="TrainAtcValidationLogic">
          <mxGeometry x="700" y="140" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="TryValidateInputs" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;TryValidateInputs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;工程2・3の結果と共通の計算入力を確認。&lt;br&gt;有効時：選択端の既知と照査位置を要求。&lt;br&gt;無効時：片側以上の位置既知を要求。&lt;br&gt;非使用側不明だけでは入力不正としない。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="TryValidateInputs" owner="TrainAtcValidationLogic">
          <mxGeometry x="700" y="380" width="500" height="180" as="geometry" />
        </mxCell>
        <mxCell id="TryReadCurrentRoute" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;TryReadCurrentRoute&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;選択端の現在Edgeと照査方向を用いて、&lt;br&gt;使用受電器の電文内の経路を取得。&lt;br&gt;経路の先頭Edgeと現在Edgeを照合する。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="TryReadCurrentRoute" owner="TrainAtcValidationLogic">
          <mxGeometry x="700" y="620" width="500" height="140" as="geometry" />
        </mxCell>
