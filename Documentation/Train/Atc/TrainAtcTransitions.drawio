        <mxCell id="CopyPosition" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;CopyPosition&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Edge ID・距離・編成の向きをコピー。&lt;br&gt;呼び出し元：InitializePosition / CorrectPosition / TryAdvancePosition&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="CopyPosition" owner="TrainAtcPositionLogic">
