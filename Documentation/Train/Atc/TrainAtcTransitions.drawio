        <mxCell id="TryGetAtcEdge" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;TryGetAtcEdge&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;辞書からEdgeを取得し、長さを確認。&lt;br&gt;呼び出し元：位置確認 / 移動 / 経路・Graph解決&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="TryGetAtcEdge" owner="TrainAtcPositionLogic">
          <mxGeometry x="1320" y="2390" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;復帰条件と入力時刻&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;相対解決は、そのtickに更新できた既知の基準位置だけから行う。&lt;br&gt;基準端更新失敗・共通移動入力不正は両端不明。片側の相対失敗は対象端だけ不明。&lt;br&gt;受信時刻と位置積分の時刻を揃える変更は今回含めず、既存の速度 × dtを維持する。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;">
          <mxGeometry x="80" y="2670" width="1740" height="180" as="geometry" />
        </mxCell>
