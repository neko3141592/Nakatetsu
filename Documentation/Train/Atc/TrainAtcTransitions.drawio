  <diagram name="TrainAtcOperationLogic.cs" id="atc-TrainAtcOperationLogic">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="1210" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" value="TrainAtcOperationLogic.cs" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;fontSize=24;strokeColor=none;fillColor=none;">
          <mxGeometry x="80" y="30" width="1160" height="36" as="geometry" />
        </mxCell>
        <mxCell id="caption" parent="1" value="工程3。電源は常にON。有効条件は操作確認成功・キー投入・レバーサ前進または後退。" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;fontSize=15;strokeColor=none;fillColor=none;">
          <mxGeometry x="80" y="76" width="1160" height="40" as="geometry" />
