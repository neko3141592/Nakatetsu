          <mxGeometry x="80" y="420" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="UpdateNormalBrakeState" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;UpdateNormalBrakeState&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;全閉未確認は転動防止として常用最大。&lt;br&gt;全閉後は速度超過・緩解と停止保持を通常判定。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="UpdateNormalBrakeState" owner="TrainAtcBrakeLogic">
          <mxGeometry x="700" y="800" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ClearNormalBrakeStep" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;ClearNormalBrakeStep&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;要求なしの場合に常用段を0にし、&lt;br&gt;テーブル履歴と待ち時間を消去。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="ClearNormalBrakeStep" owner="TrainAtcBrakeLogic">
