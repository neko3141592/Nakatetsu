      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" value="TrainAtcOperationLogic.cs" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;fontSize=24;strokeColor=none;fillColor=none;">
          <mxGeometry x="80" y="30" width="1160" height="36" as="geometry" />
        </mxCell>
        <mxCell id="caption" parent="1" value="工程2で操作・受電器・電文を選び、工程3の位置更新後に照査位置・方向を確定する。" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;fontSize=15;strokeColor=none;fillColor=none;">
          <mxGeometry x="80" y="76" width="1160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="UpdateOperation" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;UpdateOperation&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;位置更新前に、操作状態・ATC有効状態を確認。&lt;br&gt;前回の選択と照査位置を消去し、受電器・電文を選ぶ。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="UpdateOperation" owner="TrainAtcOperationLogic">
          <mxGeometry x="320" y="140" width="680" height="140" as="geometry" />
        </mxCell>
        <mxCell id="ClearReceiverSelection" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;ClearReceiverSelection&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;前回の受電器選択を消去。&lt;br&gt;currentPosition・currentTelegramはnull、方向は未指定。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="ClearReceiverSelection" owner="TrainAtcOperationLogic">
          <mxGeometry x="320" y="380" width="680" height="140" as="geometry" />
        </mxCell>
        <mxCell id="TryCaptureCabState" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;TryCaptureCabState&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;有効運転台・キー・レバーサを確認。&lt;br&gt;取得失敗は正常なキー切・中立と区別。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="TryCaptureCabState" owner="TrainAtcOperationLogic">
          <mxGeometry x="320" y="620" width="680" height="140" as="geometry" />
        </mxCell>
        <mxCell id="SelectReceiver" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;SelectReceiver&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;有効運転台側の受電器と今回の電文を選ぶ。&lt;br&gt;位置・方向はまだ設定しない。&lt;br&gt;キー切・中立では未選択。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="SelectReceiver" owner="TrainAtcOperationLogic">
          <mxGeometry x="320" y="880" width="680" height="180" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" parent="1" source="UpdateOperation" target="ClearReceiverSelection" value="" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontSize=13;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" parent="1" source="ClearReceiverSelection" target="TryCaptureCabState" value="" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontSize=13;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-3" parent="1" source="TryCaptureCabState" target="SelectReceiver" value="確認成功・キーON・レバーサ前／後" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#222222;strokeWidth=1.5;fontSize=13;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="UpdateCurrentPosition" parent="1" value="&lt;b style=&quot;font-size:17px&quot;&gt;UpdateCurrentPosition&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;親LogicがUpdatePosition後に呼ぶ。&lt;br&gt;ATC有効かつ選択端が既知なら位置をコピーし、&lt;br&gt;運転台・レバーサ・編成の向きから照査方向を求める。&lt;br&gt;非使用側だけの不明は照査を妨げない。&lt;br&gt;選択端不明なら照査位置・方向を設定しない。&lt;/span&gt;" vertex="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;strokeColor=#222222;strokeWidth=1.5;fillColor=#ffffff;" function="UpdateCurrentPosition" owner="TrainAtcOperationLogic">
          <mxGeometry x="1160" y="380" width="680" height="230" as="geometry" />
        </mxCell>
        <mxCell id="position-update-note" parent="1" value="TrainAtcLogicから、PositionLogic.UpdatePositionの後に呼ぶ。&lt;br&gt;子Logic同士は呼び合わない。" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Hiragino Kaku Gothic ProN;fontColor=#222222;fontSize=15;strokeColor=none;fillColor=none;">
          <mxGeometry x="1160" y="140" width="680" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
